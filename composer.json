{
  "name": "jtl/changelog-extractor",
  "authors": [
    {
      "name": "Tim Platzke",
      "email": "tim.platzke@jtl-software.com",
      "homepage": "https://jtl-software.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "league/commonmark": "^2.3",
    "symfony/console": "^5.4"
  },
  "autoload": {
    "psr-4": {
      "Jtl\\Changelog\\Extractor\\": "src/"
    }
  },
  "require-dev": {
    "symfony/var-dumper": "^5.4",
    "squizlabs/php_codesniffer": "^3.7",
    "slevomat/coding-standard": "^8.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^1.10"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "bin": [
    "bin/changelog-extractor"
  ]
}
